# Copia questo file in .env (lo fa già ./scripts/up.sh, generando anche i segreti).
# .env NON va mai versionato.

# --- Django ---
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=cambiami
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# In produzione usa un percorso non ovvio per l'admin, con la barra finale.
DJANGO_ADMIN_PATH=admin/

# --- Porte pubblicate sull'host ---
# Scelte per non collidere con gli altri servizi della macchina di sviluppo.
# ./scripts/check_ports.sh verifica che siano libere prima di avviare Docker.
# DV_BIND riguarda solo l'app web: 127.0.0.1 = solo questo computer,
# 0.0.0.0 = raggiungibile dalla rete locale (database e Redis restano sempre locali).
DV_BIND=127.0.0.1
DV_WEB_PORT=8100
DV_DB_PORT=5440
DV_REDIS_PORT=6390

# --- Database ---
DB_NAME=djangovault
DB_USER=djangovault
DB_PASSWORD=cambiami

# --- Elaborazione dei file (Fase 6) ---
# Processi paralleli del worker: ogni OCR usa una CPU.
DV_WORKER_CONCURRENCY=2
# 1 = include LibreOffice nell'immagine Docker (anteprime di Word/Excel/PowerPoint e vecchi .doc/.xls/.ppt).
# Dopo averlo cambiato: docker compose build
INSTALL_LIBREOFFICE=0
# Lingue dell'OCR (devono essere installate in Tesseract) e pagine massime sottoposte a OCR per file.
PROCESSING_OCR_LANGS=ita+eng
PROCESSING_OCR_MAX_PAGES=30

# --- Ricerca (Fase 7) ---
# Modello locale per la ricerca per significato. Se lo cambi: indicizza_versioni --tutte (e EMBEDDING_DIM deve coincidere con la colonna).
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Punteggio minimo (0-1) perché un passaggio conti come pertinente. Con e5 i testi non correlati stanno intorno a 0.75.
SEARCH_SEMANTIC_MIN_SCORE=0.80

# --- Servizi esterni (fasi successive) ---
ANTHROPIC_API_KEY=
# Assistente «Chiedi» (Fase 8). Modello che risponde, e modello piccolo che riformula la domanda per la ricerca (vuoto = nessuna riformulazione).
AI_MODEL=claude-sonnet-4-6
AI_QUERY_MODEL=claude-haiku-4-5
# Domande per utente all'ora e lunghezza massima di una domanda.
AI_MAX_QUESTIONS_PER_HOUR=30
# Pertinenza dei passaggi dati al modello: soglia minima (0-1) e margine massimo dal passaggio migliore. Più alti/stretti = meno fonti.
AI_MIN_SCORE=0.80
# Passaggi massimi per risposta e documenti elencati per termine nelle domande «dove compare X»
AI_MAX_PASSAGES=12
AI_MAX_OCCURRENCES=15
AI_SCORE_MARGIN=0.06

# Registro operazioni: attivare SOLO dietro un proxy fidato (Nginx) che imposta X-Forwarded-For
AUDIT_TRUST_X_FORWARDED_FOR=0
