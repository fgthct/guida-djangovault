# Produzione: copia in .env.prod (lo fa ./scripts/prod.sh init, con segreti casuali). NON va mai versionato.

# --- Django ---
DJANGO_SECRET_KEY=cambiami
# Il nome (o i nomi, separati da virgola) con cui gli utenti aprono il sito. Obbligatorio.
DJANGO_ALLOWED_HOSTS=dms.example.org
# Con HTTPS: https://dms.example.org (stessa origine delle pagine). Serve per i moduli POST.
DJANGO_CSRF_TRUSTED_ORIGINS=https://dms.example.org
# Percorso non ovvio per l'admin, con la barra finale.
DJANGO_ADMIN_PATH=gestione-x7k2/
# 1 = reindirizza a HTTPS e cookie «Secure» (modo https). 0 = solo se HTTPS lo porta un altro proxy/tunnel davanti,
# oppure rete interna senza HTTPS (le password viaggerebbero in chiaro: sconsigliato fuori da una rete fidata).
DJANGO_SECURE_SSL=1
# Attivare (es. 31536000) solo quando il HTTPS funziona da giorni: il browser lo ricorda e non torna indietro.
DJANGO_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO

# --- Nginx ---
# Modo: https (Nginx termina il TLS; certificati in DV_CERTS_DIR) oppure http.
DV_NGINX_MODE=https
DV_SERVER_NAME=dms.example.org
DV_CERTS_DIR=./deploy/certs
DV_HTTP_PORT=80
DV_HTTPS_PORT=443
# Interfaccia su cui ascolta (0.0.0.0 = tutte; 127.0.0.1 = solo questo computer, per un tunnel).
DV_BIND=0.0.0.0
# Dimensione massima di una richiesta: un po' più di DOCUMENTS_MAX_UPLOAD_MB.
DV_NGINX_MAX_BODY=60m

# --- Database ---
DB_NAME=djangovault
DB_USER=djangovault
DB_PASSWORD=cambiami

# --- Elaborazione dei file ---
DV_WORKER_CONCURRENCY=2
INSTALL_LIBREOFFICE=0
PROCESSING_OCR_LANGS=ita+eng
PROCESSING_OCR_MAX_PAGES=30
DOCUMENTS_MAX_UPLOAD_MB=50

# --- Ricerca e assistente ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
SEARCH_SEMANTIC_MIN_SCORE=0.80
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_QUERY_MODEL=claude-haiku-4-5
AI_MAX_QUESTIONS_PER_HOUR=30
AI_MIN_SCORE=0.80
AI_SCORE_MARGIN=0.06
AI_MAX_PASSAGES=12
AI_MAX_OCCURRENCES=15

# --- Conservazione dei dati (giorni; 0 = per sempre) ---
# Il registro delle operazioni è la prova di chi ha fatto cosa: di norma si lascia a 0.
AUDIT_RETENTION_DAYS=0
# Notifiche già lette.
NOTIFICATION_RETENTION_DAYS=90

# --- Ingestione automatica (cartella osservata, posta, invio dal laptop) ---
# Utente proprietario dei documenti in arrivo (vuoto = il primo superutente).
INGESTIONE_UTENTE=
# I documenti in arrivo possono essere letti dall'IA? Di norma NO: lo decidi tu documento per documento.
INGESTIONE_CONSENSO_IA=0
# Importare anche le immagini (png/jpg...)? Di norma no.
INGESTIONE_IMMAGINI=0
# Secondi tra un controllo e l'altro della cartella inbox/arrivi (0 = spento) e anzianità minima di un file.
INGESTIONE_CARTELLA_OGNI=120
INGESTIONE_ETA_MINIMA=60
# Casella email dedicata (IMAP). Serve una password per app (Gmail: Sicurezza → Password per le app).
# Se uno qualsiasi dei campi manca, la posta resta spenta. INGESTIONE_MITTENTI è OBBLIGATORIO:
# indirizzi o @dominio separati da virgola; si accetta solo posta con SPF o DKIM verificato.
INGESTIONE_IMAP_HOST=
INGESTIONE_IMAP_PORTA=993
INGESTIONE_IMAP_UTENTE=
INGESTIONE_IMAP_PASSWORD=
INGESTIONE_IMAP_CARTELLA=INBOX
INGESTIONE_MITTENTI=
INGESTIONE_POSTA_OGNI=300
# Un'email senza allegati diventa una nota di testo?
INGESTIONE_POSTA_CORPO=1
